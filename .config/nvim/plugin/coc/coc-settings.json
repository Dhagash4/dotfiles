{
  // Global
  "coc.preferences.useQuickfixForLocations": true,

  // Language-specific overrides
  "[python]": {
    "coc.preferences.formatOnSave": false
  },
  "[cpp]": {
    "coc.preferences.formatOnSave": false
  },
  "[c]": {
    "coc.preferences.formatOnSave": true
  },
  "[tex]": {
    "coc.preferences.formatOnSave": true
  },
  "[markdown]": {
    "coc.preferences.formatOnSave": true
  },
  "[cmake]": {
    "coc.preferences.formatOnSave": false
  },

  // Python
  "python.formatting.provider": "black",
  "python.linting.pylintEnabled": false,
  "pyright.enable": true,
  "inlayHint.enable": false,
  // ROS 2 Humble: lets pyright resolve rclpy and generated *.msg/*.srv imports.
  // For your own packages' messages, add their install/.../site-packages via a
  // per-workspace pyrightconfig.json.
  "python.analysis.extraPaths": [
    "/opt/ros/humble/lib/python3.10/site-packages",
    "/opt/ros/humble/local/lib/python3.10/dist-packages"
  ],

  // C++
  "clangd.enabled": true,
  "clangd.compilationDatabaseCandidates": [
    "${workspaceFolder/build/}",
    "${workspaceFolder}"
  ],
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--inlay-hints=false",
    "--query-driver=/usr/bin/c++",
    "--all-scopes-completion",
    "--pch-storage=memory",
    "--header-insertion=never"
  ],
  "clangd.fallbackFlags": ["-std=c++17"],
  "clangd.path": "/usr/bin/clangd",

  // LaTeX
  "coc.source.vimtex.filetypes": ["tex"],
  "coc.source.word.filetypes": ["latex", "markdown"],

  // Snippets
  "snippets.ultisnips.pythonPrompt": false
}
